{
  "version": 1,
  "allowed_root": "C:\\ProgramData\\coord\\actions",
  "profiles": {
    "emote-publisher-v1": {
      "version": 1,
      "on_task_completed": {
        "executable": "C:\\ProgramData\\coord\\actions\\bin\\coord-emote-publisher.exe",
        "working_directory": "C:\\ProgramData\\coord\\actions\\work",
        "args": ["--event", "{event_id}", "--task", "{task_id}"],
        "include_result": true,
        "timeout_ms": 300000,
        "max_output_bytes": 65536,
        "max_attempts": 1,
        "idempotent": false
      },
      "on_batch_completed": {
        "executable": "C:\\ProgramData\\coord\\actions\\bin\\coord-emote-index.exe",
        "working_directory": "C:\\ProgramData\\coord\\actions\\work",
        "args": ["--event", "{event_id}", "--batch", "{batch_id}"],
        "timeout_ms": 300000,
        "max_output_bytes": 65536,
        "max_attempts": 1,
        "idempotent": false
      }
    }
  }
}
